<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Network access for Kaspa node connections and the indexers -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Camera: scanning an address to send to -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!-- Haptic feedback -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Biometric/device-credential prompt guarding the seed phrase and account unlock -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <!-- Play derives REQUIRED hardware from the permissions above unless told otherwise: CAMERA
         implies android.hardware.camera, which would hide the app from every device without one.
         Scanning is an optional extra; it checks for the hardware at runtime. -->
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />

    <!-- usesCleartextTraffic stays true DELIBERATELY: Kaspa node gRPC (protowire on port
         16110/16210) is plaintext by protocol, and a networkSecurityConfig cannot scope a
         cleartext allowance by port - only by domain - which is useless for a pool of bare peer
         IPs. Everything HTTP in the app (indexer, KNS, REST API) is https-only at the application
         layer instead. -->
    <application
        android:name=".KaChatApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.KaChat"
        android:usesCleartextTraffic="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.KaChat"
            android:resizeableActivity="true"
            android:configChanges="screenSize|smallestScreenSize|screenLayout|orientation|keyboardHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Shares a crash report from app-private cache via a content:// URI, without granting
             broad file access. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Required for AppCompatDelegate.setApplicationLocales() to survive a cold app
             restart on API <33 (the Settings > Language row uses this API). No-op on API 33+. -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
